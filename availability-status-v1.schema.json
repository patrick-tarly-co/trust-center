{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/patrick-tarly-co/trust-center/main/availability-status-v1.schema.json",
  "title": "Tarly Cowork public availability status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "provider", "service", "fedRampPackageId", "generated_at",
    "current_status", "services", "history_window_days", "observed_days",
    "expected_days_since_monitoring_started", "history_complete", "daily_history", "incidents"
  ],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/patrick-tarly-co/trust-center/main/availability-status-v1.schema.json"},
    "provider": {"const": "Pincus Technologies Inc"},
    "service": {"const": "Tarly Cowork"},
    "fedRampPackageId": {"const": "FR2628650874"},
    "generated_at": {"type": "string", "format": "date-time"},
    "current_status": {"enum": ["operational", "degraded", "outage"]},
    "services": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/serviceObservation"}},
    "history_window_days": {"const": 30},
    "observed_days": {"type": "integer", "minimum": 1, "maximum": 30},
    "expected_days_since_monitoring_started": {"type": "integer", "minimum": 1, "maximum": 30},
    "history_complete": {"type": "boolean"},
    "daily_history": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/sample"}},
    "incidents": {"type": "array", "items": {"$ref": "#/$defs/incident"}}
  },
  "$defs": {
    "serviceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "operational", "http_status", "latency_ms"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "operational": {"type": "boolean"},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "latency_ms": {"type": "integer", "minimum": 0},
        "content_check": {"enum": ["json-field", "text-markers"]},
        "content_verified": {"type": "boolean"},
        "error": {"type": "string", "minLength": 1}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_at", "status", "services", "sample_sha256"],
      "properties": {
        "fedRampPackageId": {"const": "FR2628650874"},
        "checked_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["operational", "degraded", "outage"]},
        "services": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/serviceObservation"}},
        "sample_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "status", "affected_services"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": ["string", "null"], "format": "date-time"},
        "status": {"enum": ["degraded", "outage"]},
        "affected_services": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
